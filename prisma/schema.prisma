generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth Models ───

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Domain Models ───

enum UserRole {
  OPERATOR
  AGENCY
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String?
  role          UserRole  @default(AGENCY)
  agencyId      String?
  agency        Agency?   @relation(fields: [agencyId], references: [id])
  emailVerified DateTime?
  image         String?
  isActive      Boolean   @default(true)
  accounts      Account[]
  sessions      Session[]
  auditLogs     AuditLog[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum AgencyStatus {
  PENDING
  ACTIVE
  SUSPENDED
  TERMINATED
}

model Agency {
  id                String       @id @default(cuid())
  code              String       @unique
  name              String
  contactName       String
  contactEmail      String
  contactPhone      String?
  status            AgencyStatus @default(PENDING)

  bankName          String?
  bankBranchName    String?
  bankAccountType   String?
  bankAccountNumber String?
  bankAccountHolder String?

  payoutThreshold   Decimal      @default(10000) @db.Decimal(12, 2)
  holdPeriodDays    Int          @default(14)

  depositAmount      Decimal      @default(132000) @db.Decimal(12, 2)
  depositPaid        Boolean      @default(false)
  depositRefunded    Boolean      @default(false)
  depositRefundable  Boolean      @default(false)
  depositRefundNote  String?

  users             User[]
  commissionRules   CommissionRule[]
  salesRecords      SalesRecord[]
  commissionEvents  CommissionEvent[]
  balance           Balance?
  payoutRequests    PayoutRequest[]
  notes             String?

  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model Plan {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  description     String?
  monthlyPrice    Decimal?         @db.Decimal(12, 2)
  isActive        Boolean          @default(true)
  commissionRules CommissionRule[]
  salesRecords    SalesRecord[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

enum CommissionType {
  PERCENTAGE
  FIXED_AMOUNT
}

model CommissionRule {
  id               String            @id @default(cuid())
  agencyId         String
  agency           Agency            @relation(fields: [agencyId], references: [id])
  planId           String?
  plan             Plan?             @relation(fields: [planId], references: [id])
  commissionType   CommissionType    @default(PERCENTAGE)
  rate             Decimal           @db.Decimal(8, 4)
  effectiveFrom    DateTime
  effectiveTo      DateTime?
  description      String?
  commissionEvents CommissionEvent[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([agencyId, planId, effectiveFrom])
  @@index([agencyId, effectiveFrom, effectiveTo])
}

enum SalesStatus {
  SUCCESS
  FAILED
  REFUNDED
}

model SalesRecord {
  id                String          @id @default(cuid())
  agencyId          String
  agency            Agency          @relation(fields: [agencyId], references: [id])
  planId            String?
  plan              Plan?           @relation(fields: [planId], references: [id])
  transactionDate   DateTime
  customerName      String?
  customerRef       String?
  contractId        String?
  saleAmountExTax   Decimal         @db.Decimal(12, 2)
  saleAmountIncTax  Decimal         @db.Decimal(12, 2)
  taxAmount         Decimal         @db.Decimal(12, 2)
  quantity          Int             @default(1)
  paymentStatus     SalesStatus     @default(SUCCESS)
  source            String          @default("csv")
  importBatchId     String?
  externalId        String?         @unique
  commissionEvent   CommissionEvent?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([agencyId, transactionDate])
  @@index([importBatchId])
  @@index([paymentStatus])
}

enum CommissionEventStatus {
  HOLD
  CONFIRMED
  INVALIDATED
  PAID
}

model CommissionEvent {
  id               String                @id @default(cuid())
  agencyId         String
  agency           Agency                @relation(fields: [agencyId], references: [id])
  salesRecordId    String                @unique
  salesRecord      SalesRecord           @relation(fields: [salesRecordId], references: [id])
  commissionRuleId String
  commissionRule   CommissionRule         @relation(fields: [commissionRuleId], references: [id])
  saleAmount       Decimal               @db.Decimal(12, 2)
  commissionType   CommissionType
  commissionRate   Decimal               @db.Decimal(8, 4)
  agencyAmount     Decimal               @db.Decimal(12, 2)
  operatorAmount   Decimal               @db.Decimal(12, 2)
  status           CommissionEventStatus @default(HOLD)
  holdUntil        DateTime?
  confirmedAt      DateTime?
  invalidatedAt    DateTime?
  invalidReason    String?
  periodYear       Int
  periodMonth      Int
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([agencyId, periodYear, periodMonth])
  @@index([status])
  @@index([holdUntil])
}

model Balance {
  id               String   @id @default(cuid())
  agencyId         String   @unique
  agency           Agency   @relation(fields: [agencyId], references: [id])
  confirmedBalance Decimal  @default(0) @db.Decimal(12, 2)
  holdBalance      Decimal  @default(0) @db.Decimal(12, 2)
  totalEarned      Decimal  @default(0) @db.Decimal(12, 2)
  totalPaidOut     Decimal  @default(0) @db.Decimal(12, 2)
  lastCalculatedAt DateTime?
  updatedAt        DateTime @updatedAt
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

model PayoutRequest {
  id                String       @id @default(cuid())
  agencyId          String
  agency            Agency       @relation(fields: [agencyId], references: [id])
  amount            Decimal      @db.Decimal(12, 2)
  transferFee       Decimal      @default(0) @db.Decimal(12, 2)
  netAmount         Decimal      @db.Decimal(12, 2)
  status            PayoutStatus @default(REQUESTED)
  bankName          String
  bankBranchName    String?
  bankAccountType   String?
  bankAccountNumber String
  bankAccountHolder String
  targetPeriodFrom  DateTime?
  targetPeriodTo    DateTime?
  requestedAt       DateTime     @default(now())
  approvedAt        DateTime?
  approvedBy        String?
  paidAt            DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?
  notes             String?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([agencyId, status])
  @@index([status])
}

model ImportBatch {
  id          String   @id @default(cuid())
  fileName    String
  uploadedBy  String
  totalRows   Int
  successRows Int      @default(0)
  errorRows   Int      @default(0)
  status      String   @default("processing")
  errors      Json?
  createdAt   DateTime @default(now())
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  LOGIN
  EXPORT
  CALCULATE
  IMPORT
  PAYOUT
}

model AuditLog {
  id         String      @id @default(cuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id])
  action     AuditAction
  entityType String
  entityId   String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
